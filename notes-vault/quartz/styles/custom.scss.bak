@use "./variables.scss" as *;

// ---------------------------------------------------------------------------
// Portfolio-matching theme pass.
// Colors/fonts themselves come from quartz.config.yaml's `theme` block (CSS
// vars: --light, --dark, --gray, --darkgray, --secondary, --tertiary, etc.)
// This file handles the structural stuff config can't: card chrome, borders,
// radii, hover states — the actual "rounded-xl border border-line bg-black/30"
// card language the rest of the portfolio uses.
// ---------------------------------------------------------------------------

:root {
  --radius: 0.75rem; // rounded-xl, matches portfolio cards
  --border-color: color-mix(in srgb, var(--lightgray) 100%, transparent);
}

body {
  background: var(--light);
}

h1,
h2,
h3,
h4 {
  font-family: var(--headerFont);
  letter-spacing: -0.01em;
}

.article-title {
  font-weight: 600;
}

a.internal,
a.external {
  color: var(--secondary);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 0.2s ease, color 0.2s ease;
}
a.internal:hover,
a.external:hover {
  color: var(--tertiary);
  border-bottom-color: color-mix(in srgb, var(--tertiary) 50%, transparent);
}

pre {
  background: color-mix(in srgb, var(--light) 85%, black) !important;
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 1rem !important;
}
code {
  font-family: var(--codeFont);
}
:not(pre) > code {
  background: color-mix(in srgb, var(--tertiary) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--tertiary) 25%, transparent);
  border-radius: 4px;
  padding: 0.1rem 0.35rem;
}

.callout {
  border-radius: var(--radius);
  border: 1px solid var(--border-color);
  border-left: 2px solid var(--tertiary);
  background: color-mix(in srgb, var(--tertiary) 6%, transparent);
}

.note-properties {
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  background: color-mix(in srgb, var(--light) 85%, black);
  overflow: hidden;
}
.note-properties-header {
  font-family: var(--codeFont);
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--tertiary) 60%, transparent);
}

.sidebar > * {
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
}

.explorer {
  font-family: var(--codeFont);
  font-size: 0.8rem;
}
.explorer .folder-button:hover,
.explorer a:hover {
  color: var(--tertiary);
}

.search-button {
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  background: color-mix(in srgb, var(--light) 85%, black);
  transition: border-color 0.2s ease;
}
.search-button:hover {
  border-color: color-mix(in srgb, var(--tertiary) 50%, transparent);
}
.search-layout {
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  background: var(--light);
}

.toc-content {
  border-left: 1px solid var(--border-color);
  padding-left: 1rem;
}
.toc-header {
  font-family: var(--codeFont);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: color-mix(in srgb, var(--tertiary) 55%, transparent);
}

.breadcrumb-container {
  font-family: var(--codeFont);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--gray);
}

.section-li {
  list-style: none;
}
.section {
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 1rem 1.25rem;
  margin-bottom: 0.75rem;
  transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}
.section:hover {
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--tertiary) 35%, transparent);
  background: color-mix(in srgb, var(--tertiary) 4%, transparent);
}

::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: var(--lightgray);
  border-radius: 999px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--gray);
}
